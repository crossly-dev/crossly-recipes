{
  "$schema": "https://crossly.net/schemas/automation-recipe-v1.json",
  "schemaVersion": 1,
  "name": "Ladder step three — 15% at 90 days",
  "description": "The last step before you should be asking whether to relist or archive instead.",
  "trigger": {
    "type": "listing.age_reached",
    "config": {
      "ageDays": 90
    }
  },
  "action": {
    "type": "listing.price_drop",
    "config": {
      "mode": "percent",
      "percent": 15,
      "floor": 10,
      "minDaysListed": 90
    }
  }
}
